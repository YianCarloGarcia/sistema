# Plantilla de variables de entorno. COPIE los nombres en Railway → Variables.
# Este archivo es solo de referencia: NO escriba aquí las claves reales.

# ── Django ───────────────────────────────────────────────────
# Genere una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=pegue-aqui-una-clave-nueva-y-larga
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=su-app.up.railway.app

# ── Base de datos (Neon) ─────────────────────────────────────
# Estos datos salen del panel de Neon → Connection Details.
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=la-clave-que-le-da-neon
DB_HOST=ep-algo-12345.us-east-2.aws.neon.tech
DB_PORT=5432

# ── Fotos de estudiantes (Cloudflare R2) ─────────────────────
R2_BUCKET=fotos-estudiantes
R2_ACCESS_KEY_ID=su-access-key-de-r2
R2_SECRET_ACCESS_KEY=su-secret-key-de-r2
R2_ENDPOINT_URL=https://SU_ACCOUNT_ID.r2.cloudflarestorage.com
# Dominio público del bucket (r2.dev o su dominio propio)
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ── Correo (opcional) ────────────────────────────────────────
# Si se dejan vacías, los correos solo se imprimen en los logs.
EMAIL_USER=
EMAIL_PASSWORD=
